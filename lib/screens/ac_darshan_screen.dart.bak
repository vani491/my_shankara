// ─────────────────────────────────────────────────────────────────────────────
// BOTTOM CTA
// ─────────────────────────────────────────────────────────────────────────────
class _DarshanCTA extends StatelessWidget {
  final int step;
  final String ctaLabel;
  final Color ctaColor;
  final VoidCallback onCTA;
  final VoidCallback onReturnHome;

  const _DarshanCTA({
    required this.step,
    required this.ctaLabel,
    required this.ctaColor,
    required this.onCTA,
    required this.onReturnHome,
  });

  @override
  Widget build(BuildContext context) {

    final theme = Theme.of(context);
    final cs = theme.colorScheme;

    return Container(
      padding: const EdgeInsets.fromLTRB(24, 12, 24, 20),
      decoration: BoxDecoration(
        color: Colors.transparent,
        border: Border(
          top: BorderSide(
              color: Colors.black.withOpacity(0.06), width: 1),
        ),
      ),
      child: Column(
        children: [
          SizedBox(
            width: double.infinity,
            height: 54,
            child: FilledButton(
              onPressed: onCTA,
              style: FilledButton.styleFrom(
                backgroundColor: ctaColor,
              ),
              child: Row(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Text(
                    ctaLabel,
                    style: theme.textTheme.bodyLarge?.copyWith(
                      color: Colors.white
                    ),
                  ),
                  const SizedBox(width: 8),
                  Icon(
                    step == 3
                        ? Icons.check_rounded
                        : Icons.arrow_forward_rounded,
                    size: 18,
                    color: Colors.white,
                  ),
                ],
              ),
            ),
          ),
          const SizedBox(height: 10),
          if (step < 3)
            const Text(
              'Swipe left or tap to continue',
              style: TextStyle(
                fontSize: 12,
                color: _DarshanScreenState._textLight,
              ),
            ),
          if (step == 3)
            GestureDetector(
              onTap: onReturnHome,
              child: const Text(
                'Return to Home',
                style: TextStyle(
                  fontSize: 13,
                  fontWeight: FontWeight.w600,
                  color: _DarshanScreenState._textMid,
                  decoration: TextDecoration.underline,
                ),
              ),
            ),
        ],
      ),
    );
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// SHARED: Sunrise Landscape Illustration
// ─────────────────────────────────────────────────────────────────────────────
class _SunriseLandscape extends StatelessWidget {
  final Color tint;
  const _SunriseLandscape({required this.tint});

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      height: 90,
      child: CustomPaint(
        size: const Size(double.infinity, 90),
        painter: _LandscapePainter(tint: tint),
      ),
    );
  }
}

class _LandscapePainter extends CustomPainter {
  final Color tint;
  const _LandscapePainter({required this.tint});

  @override
  void paint(Canvas canvas, Size size) {
    final w = size.width;
    final h = size.height;

    // Sky gradient
    final skyPaint = Paint()
      ..shader = LinearGradient(
        begin: Alignment.topCenter,
        end: Alignment.bottomCenter,
        colors: [
          tint.withOpacity(0.05),
          tint.withOpacity(0.14),
        ],
      ).createShader(Rect.fromLTWH(0, 0, w, h));
    canvas.drawRect(Rect.fromLTWH(0, 0, w, h), skyPaint);

    // Sun
    final sunPaint = Paint()..color = tint.withOpacity(0.35);
    canvas.drawCircle(Offset(w / 2, h * 0.35), 22, sunPaint);
    final sunCorePaint = Paint()..color = tint.withOpacity(0.55);
    canvas.drawCircle(Offset(w / 2, h * 0.35), 14, sunCorePaint);

    // Far mountain
    final farMtnPaint = Paint()..color = tint.withOpacity(0.12);
    final farMtn = Path()
      ..moveTo(0, h * 0.75)
      ..lineTo(w * 0.2, h * 0.35)
      ..lineTo(w * 0.45, h * 0.6)
      ..lineTo(w * 0.65, h * 0.3)
      ..lineTo(w * 0.85, h * 0.55)
      ..lineTo(w, h * 0.45)
      ..lineTo(w, h)
      ..lineTo(0, h)
      ..close();
    canvas.drawPath(farMtn, farMtnPaint);

    // Near mountain
    final nearMtnPaint = Paint()..color = tint.withOpacity(0.2);
    final nearMtn = Path()
      ..moveTo(0, h)
      ..lineTo(w * 0.15, h * 0.58)
      ..lineTo(w * 0.35, h * 0.78)
      ..lineTo(w * 0.55, h * 0.5)
      ..lineTo(w * 0.75, h * 0.72)
      ..lineTo(w, h * 0.6)
      ..lineTo(w, h)
      ..close();
    canvas.drawPath(nearMtn, nearMtnPaint);
  }

  @override
  bool shouldRepaint(_LandscapePainter old) => old.tint != tint;
}